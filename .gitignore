# Written by `npm run seo:report` — a build artefact, never a source of truth.
seo-report.json
next-env.d.ts
.DS_Store
.vercel

# env files — most carry nothing safe to commit
.env*
!.env.example
# .env.production is the exception: NEXT_PUBLIC_SITE_URL and
# NEXT_PUBLIC_ADSENSE_CLIENT are both inlined into the client bundle at build
# time regardless of where they are set, so there is no secret to protect —
# and committing the real values here means the production build is correct
# no matter how the host's deploy mechanism handles environment variables.
!.env.production

# Regenerated by `next dev` on every run.
apps/web/AGENTS.md
apps/web/CLAUDE.md
