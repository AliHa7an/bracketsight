    "remark-frontmatter": "5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@types/d3-scale": "4.0.9",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
