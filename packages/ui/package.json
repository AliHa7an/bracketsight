{
  "name": "@fineprint/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Fineprint design system. Reads only the six semantic colour tokens and the shared scale, so a section re-themes it by redefining those six values. Zero runtime dependencies.",
