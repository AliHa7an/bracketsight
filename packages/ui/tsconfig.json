{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowJs": false,
    "esModuleInterop": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@ui": ["./src/index.ts"],
      "@ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
